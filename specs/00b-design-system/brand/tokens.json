{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Bolsilludo design tokens — single source of truth. See constitution P13.",
  "$version": "1.0.0",

  "color": {
    "brand": {
      "navy-900":    { "$value": "#0B2046", "$type": "color", "$description": "Deep background (dark), main text (light)" },
      "emerald-500": { "$value": "#16B78C", "$type": "color", "$description": "Primary bright: actions, positive, focus, progress" },
      "green-700":   { "$value": "#0B7A5A", "$type": "color", "$description": "Primary dark: hover/pressed, text/links on light theme" },
      "gold-400":    { "$value": "#F4C13A", "$type": "color", "$description": "Accent: goals, currency, achievements, positive attention" }
    },
    "derived": {
      "emerald-300": { "$value": "#5AEFBD", "$type": "color", "$description": "Logo gradient highlight" },
      "navy-800":    { "$value": "#12305F", "$type": "color", "$description": "Elevated surface over navy-900" },
      "navy-700":    { "$value": "#1B3F73", "$type": "color", "$description": "Borders / dividers in dark theme" },
      "ink-muted":   { "$value": "#A9B8D3", "$type": "color", "$description": "Secondary text in dark (8.01:1 vs navy-900)" },
      "ink-muted-l": { "$value": "#4B5D7E", "$type": "color", "$description": "Secondary text in light (6.63:1 vs white)" },
      "gold-700":    { "$value": "#7A5800", "$type": "color", "$description": "Golden text on light background (6.51:1 vs white)" }
    },
    "semantic": {
      "danger-d": { "$value": "#FF6B70", "$type": "color", "$description": "Danger on dark (5.80:1 vs navy-900)" },
      "danger-l": { "$value": "#C62F35", "$type": "color", "$description": "Danger on light (5.44:1 vs white)" }
    }
  },

  "theme": {
    "dark": {
      "bg":          { "$value": "{color.brand.navy-900}", "$type": "color" },
      "surface-1":   { "$value": "{color.derived.navy-800}", "$type": "color" },
      "text":        { "$value": "#FFFFFF", "$type": "color" },
      "text-muted":  { "$value": "{color.derived.ink-muted}", "$type": "color" },
      "primary":     { "$value": "{color.brand.emerald-500}", "$type": "color" },
      "on-primary":  { "$value": "{color.brand.navy-900}", "$type": "color" },
      "accent":      { "$value": "{color.brand.gold-400}", "$type": "color" },
      "danger":      { "$value": "{color.semantic.danger-d}", "$type": "color" }
    },
    "light": {
      "bg":          { "$value": "#F6F8FB", "$type": "color" },
      "surface-1":   { "$value": "#FFFFFF", "$type": "color" },
      "text":        { "$value": "{color.brand.navy-900}", "$type": "color" },
      "text-muted":  { "$value": "{color.derived.ink-muted-l}", "$type": "color" },
      "primary":     { "$value": "{color.brand.green-700}", "$type": "color" },
      "on-primary":  { "$value": "#FFFFFF", "$type": "color" },
      "accent":      { "$value": "{color.derived.gold-700}", "$type": "color" },
      "danger":      { "$value": "{color.semantic.danger-l}", "$type": "color" }
    }
  },

  "glass": {
    "bg":     { "$value": "rgba(255,255,255,0.08)", "$type": "color" },
    "border": { "$value": "rgba(255,255,255,0.18)", "$type": "color" },
    "blur":   { "$value": "20px", "$type": "dimension" }
  },

  "depth": {
    "z-1": { "$value": "0",  "$type": "number" },
    "z-2": { "$value": "10", "$type": "number" },
    "z-3": { "$value": "20", "$type": "number" },
    "z-4": { "$value": "30", "$type": "number" }
  },

  "typography": {
    "family-display": { "$value": "\"Outfit\", \"Inter\", system-ui, sans-serif", "$type": "fontFamily" },
    "family-body":    { "$value": "\"Inter\", system-ui, sans-serif", "$type": "fontFamily" },
    "family-mono":    { "$value": "\"JetBrains Mono\", \"Fira Code\", monospace", "$type": "fontFamily" }
  },

  "radius": {
    "sm":   { "$value": "6px",  "$type": "dimension" },
    "md":   { "$value": "12px", "$type": "dimension" },
    "lg":   { "$value": "16px", "$type": "dimension" },
    "xl":   { "$value": "24px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },

  "motion": {
    "duration-fast":   { "$value": "150ms", "$type": "duration" },
    "duration-base":   { "$value": "250ms", "$type": "duration" },
    "duration-slow":   { "$value": "350ms", "$type": "duration" },
    "easing-standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" },
    "easing-enter":    { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$type": "cubicBezier" },
    "easing-exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "cubicBezier" }
  },

  "contrast-validation": {
    "$description": "WCAG 2.2 validated pairs. See constitution P10 and section 0.5.3.",
    "pairs": [
      { "fg": "#FFFFFF",  "bg": "#0B2046", "ratio": 16.04, "aa": true, "use": "All text on dark background" },
      { "fg": "#16B78C",  "bg": "#0B2046", "ratio": 6.25,  "aa": true, "use": "Icons and text on dark" },
      { "fg": "#F4C13A",  "bg": "#0B2046", "ratio": 9.57,  "aa": true, "use": "Accent on dark" },
      { "fg": "#0B2046",  "bg": "#16B78C", "ratio": 6.25,  "aa": true, "use": "Primary button text (navy on emerald)" },
      { "fg": "#0B7A5A",  "bg": "#FFFFFF", "ratio": 5.32,  "aa": true, "use": "Links on light theme" },
      { "fg": "#FFFFFF",  "bg": "#0B7A5A", "ratio": 5.32,  "aa": true, "use": "Primary button (light theme)" },
      { "fg": "#16B78C",  "bg": "#FFFFFF", "ratio": 2.57,  "aa": false, "use": "DECORATIVE ONLY — never text or functional border" },
      { "fg": "#F4C13A",  "bg": "#FFFFFF", "ratio": 1.68,  "aa": false, "use": "NEVER as text/icon on light" },
      { "fg": "#FFFFFF",  "bg": "#16B78C", "ratio": 2.57,  "aa": false, "use": "PROHIBITED" }
    ]
  }
}
