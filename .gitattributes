# Normalize line endings across platforms
* text=auto eol=lf

# Binary files — never convert
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary

# JSON / config
*.json text eol=lf
*.jsonc text eol=lf

# Markdown
*.md text eol=lf

# TypeScript / JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# CSS
*.css text eol=lf

# SQL / migrations
*.sql text eol=lf

# Shell
*.sh text eol=lf

# Diff — do not generate diffs for:
*.png -diff
*.jpg -diff
*.jpeg -diff
*.ico -diff
*.woff -diff
*.woff2 -diff
